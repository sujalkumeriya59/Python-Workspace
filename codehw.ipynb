   "source": [
    "# WAP to reverse given string\n",
    "# wap to check whether program is palindrome or not \n",
    "# Using For loop\n",
    "\n",
    "s = \"dad\"\n",
    "reverse = \"\"\n",
    "\n",
    "for char in s:\n",
    "    reverse = char + reverse\n",
    "\n",
    "print(reverse)\n",
    "\n",
    "if reverse == s:\n",
    "     print(\"Palindrome\")\n",
    "else:\n",
    "    print(\"It is not Palindrome\")"
   ]
  }
